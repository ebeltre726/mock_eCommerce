# ── Runtime environment ──────────────────────────────────────────────
NODE_ENV=development

# ── AWS ──────────────────────────────────────────────────────────────
# No static access keys. Authentication uses AWS Identity Center (SSO).
# 1. Run: aws configure sso
# 2. Set AWS_PROFILE to the profile name you chose.
# Production: IAM role attached to Lambda/ECS — no profile needed.
AWS_REGION=us-east-1
AWS_PROFILE=your-sso-profile

# ── Cognito (dev User Pool) ───────────────────────────────────────────
# Create a dev pool once with the CLI commands in README / CONTRIBUTING.
# Production values are injected automatically by Terraform — never set here.
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── DynamoDB ──────────────────────────────────────────────────────────
DYNAMODB_TABLE=Furnitria
# Leave unset in production — only needed to point at DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000

# ── S3 / MinIO ────────────────────────────────────────────────────────
S3_BUCKET_AVATARS=avatars
S3_BUCKET_PRODUCTS=products
# Leave unset in production — only needed to point at MinIO
S3_ENDPOINT=http://localhost:9000

# ── MinIO local credentials ───────────────────────────────────────────
# MinIO-specific — separate from AWS credentials. Must match docker-compose.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Stripe ───────────────────────────────────────────────────────────
# Use a test key locally: https://dashboard.stripe.com/test/apikeys
# Production key is stored in AWS SSM — never committed here.
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX

# ── Email ─────────────────────────────────────────────────────────────
# Controls which email driver is active.
#   emailjs  — uses EmailJS REST API (default, while SES is in sandbox mode)
#   ses      — uses AWS SES directly (switch once AWS approves production access)
EMAIL_DRIVER=emailjs

# EmailJS credentials — required when EMAIL_DRIVER=emailjs.
# Obtain from https://dashboard.emailjs.com/admin
#
# Template variable reference:
#
#   EMAILJS_TEMPLATE_CONTACT      — contact form notification sent to the site owner
#     Variables: {{from_name}}, {{from_email}}, {{message}}
#     To address: set "To Email" in the template to your own inbox
#
#   EMAILJS_TEMPLATE_SUBSCRIBED   — confirmation sent to a new newsletter subscriber
#     Variables: {{to_email}}, {{to_name}}
#
#   EMAILJS_TEMPLATE_UNSUBSCRIBED — confirmation sent when a user unsubscribes
#     Variables: {{to_email}}, {{to_name}}
#
EMAILJS_SERVICE_ID=service_XXXXXXX
EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXXXXXXXXXX
EMAILJS_PRIVATE_KEY=XXXXXXXXXXXXXXXXXXXXXX
EMAILJS_TEMPLATE_CONTACT=template_XXXXXXX
EMAILJS_TEMPLATE_SUBSCRIBED=template_XXXXXXX
EMAILJS_TEMPLATE_UNSUBSCRIBED=template_XXXXXXX

# AWS SES — required when EMAIL_DRIVER=ses.
# Must be a verified sender identity in SES (domain or address).
# Migration steps:
#   1. Set EMAIL_DRIVER=ses
#   2. Set SES_FROM_ADDRESS to your verified identity
#   3. Ensure IAM role has ses:SendEmail on the identity ARN
#   4. Remove EMAILJS_* vars from SSM / environment
SES_FROM_ADDRESS=no-reply@furnitria.com

# ── CORS ─────────────────────────────────────────────────────────────
# Production value is set by Terraform to the CloudFront URL.
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000
