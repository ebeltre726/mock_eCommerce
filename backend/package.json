{
  "name": "mock_ecommerce",
  "version": "1.0.0",
  "type": "module",
  "description": "The repository for my mock e-commerce website that I will host with AWS to get recognition from employers.",
  "main": "script.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --env-file=.env server.js",
    "lint": "eslint src/**/*.js",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.js --runInBand --detectOpenHandles --forceExit",
    "test:integration": "jest --config jest.integration.config.js --runInBand --detectOpenHandles --forceExit",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:pr": "npm run test:unit && npm run test:integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebeltre726/mock_eCommerce.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ebeltre726/mock_eCommerce/issues"
  },
  "homepage": "https://github.com/ebeltre726/mock_eCommerce#readme",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1041.0",
    "@aws-sdk/client-dynamodb": "^3.1002.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-ses": "^3.1045.0",
    "@aws-sdk/client-ssm": "^3.1041.0",
    "@aws-sdk/lib-dynamodb": "^3.1002.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@vendia/serverless-express": "^4.12.6",
    "aws-jwt-verify": "^4.0.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "joi": "^18.1.2",
    "multer": "^2.1.1",
    "sharp": "^0.34.5",
    "stripe": "^20.4.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.3.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
